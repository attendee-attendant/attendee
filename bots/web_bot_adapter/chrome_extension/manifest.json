{
  "manifest_version": 3,
  "name": "Attendee Bot",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "attendee-bot@attendee.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "payload.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self';"
  }
}
